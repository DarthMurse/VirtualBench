{
  "vm_spec": {
    "vcpus": 4,
    "memory_mb": 8192
  },
  "run": {
    "repetitions": 7,
    "warmup_runs": 2,
    "results_dir": "results"
  },
  "workloads": {
    "cpu":  { "enabled": true, "tool": "7z" },
    "mem":  { "enabled": true, "tool": "sysbench", "block_size": "1M", "total_size": "4G" },
    "disk": {
      "enabled": true,
      "tool": "fio",
      "sizes": ["4k", "64k"],
      "patterns": ["randread", "randwrite", "read", "write"],
      "iodepth": 32,
      "runtime_s": 30,
      "file_size": "4G"
    },
    "net": {
      "enabled": true,
      "tool": "iperf3",
      "server": "127.0.0.1",
      "duration_s": 30,
      "ping_count": 20
    },
    "app":  { "enabled": true, "tool": "7z", "level": 5, "corpus_mb": 1024 }
  }
}
