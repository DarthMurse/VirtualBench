    },
    "net": {
      "enabled": true,
      "tool": "iperf3",
      "server": "127.0.0.1",
      "duration_s": 2,
      "ping_count": 3
    },
    "app":  { "enabled": true, "tool": "7z", "level": 1, "corpus_mb": 64 }
  }
}
