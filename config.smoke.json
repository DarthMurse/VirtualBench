{
  "vm_spec": {
    "vcpus": 2,
    "memory_mb": 2048
  },
  "run": {
    "repetitions": 1,
    "warmup_runs": 0,
    "results_dir": "results"
  },
  "workloads": {
    "cpu":  { "enabled": true, "tool": "7z" },
